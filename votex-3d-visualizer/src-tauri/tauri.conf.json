{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Votex 3D XYZ Visualizer",
  "version": "0.1.1",
  "identifier": "com.dft.votex.visualizer3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1444",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Votex 3D Spatial & Anomaly Visualizer — Digital Future Tech",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
