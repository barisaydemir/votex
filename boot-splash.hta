<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta http-equiv="Content-Type" content="text/html; charset=windows-1254" />
<title>VOTEX Yukleniyor</title>
<HTA:APPLICATION
  ID="votexBoot"
  APPLICATIONNAME="VOTEX Boot"
  BORDER="thin"
  BORDERSTYLE="static"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  SCROLL="no"
  WINDOWSTATE="normal"
/>
<style>
  html, body {
    margin: 0; height: 100%;
    background: #070a0e;
    color: #e6edf2;
    font-family: "Segoe UI", sans-serif;
    overflow: hidden;
  }
  .wrap {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(420px 220px at 50% 0%, rgba(62,220,140,0.12), transparent 60%),
      #070a0e;
  }
  .brand {
    font-size: 42px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #3edc8c;
  }
  .sub {
    margin-top: 10px;
    font-size: 13px;
    color: #7a8a96;
    letter-spacing: 0.08em;
  }
  .msg {
    margin-top: 28px;
    font-size: 14px;
    color: #bfdbfe;
  }
  .bar {
    margin-top: 18px;
    width: 220px;
    height: 3px;
    background: #1e293b;
    overflow: hidden;
  }
  .bar > i {
    display: block;
    height: 100%;
    width: 40%;
    background: #3edc8c;
    animation: slide 1.1s ease-in-out infinite;
  }
  @keyframes slide {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(280%); }
  }
  .hint {
    margin-top: 22px;
    font-size: 11px;
    color: #64748b;
  }
</style>
<script language="javascript">
  window.resizeTo(420, 280);
  window.moveTo(
    (screen.width - 420) / 2,
    (screen.height - 280) / 3
  );

  var ticks = 0;
  var sh = new ActiveXObject("WScript.Shell");
  var closed = false;

  function closeSplash() {
    if (closed) return;
    closed = true;
    try { window.close(); } catch (e) {}
  }

  function isVotexExeRunning() {
    try {
      var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
      var procs = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE Name='votex.exe'");
      if (procs && procs.Count > 0) return true;
    } catch (e) {}
    try {
      var exec = sh.Exec("cmd /c tasklist /FI \"IMAGENAME eq votex.exe\" /NH");
      var out = "";
      while (!exec.StdOut.AtEndOfStream) {
        out += exec.StdOut.ReadLine() + "\n";
      }
      if (out.toLowerCase().indexOf("votex.exe") >= 0) return true;
    } catch (e2) {}
    return false;
  }

  function focusVotexWindow() {
    try {
      if (sh.AppActivate("Votex - Manyetik Anomali Analiz")) return true;
      if (sh.AppActivate("Votex - Manyetik")) return true;
    } catch (e) {}
    return false;
  }

  function tick() {
    if (closed) return;
    ticks++;

    var running = isVotexExeRunning();
    var focused = false;
    if (ticks >= 3) focused = focusVotexWindow();

    if (running || focused) {
      focusVotexWindow();
      window.setTimeout(closeSplash, 500);
      return;
    }

    if (ticks === 20) {
      document.getElementById("msg").innerHTML = "Derleniyor&hellip; biraz s&uuml;rebilir";
    }
    if (ticks === 90) {
      document.getElementById("msg").innerHTML = "H&acirc;l&acirc; a&ccedil;&#305;l&#305;yor&hellip;";
    }
    // En fazla ~3 dk; sonra kapat (arka planda acilmis olabilir)
    if (ticks >= 180) {
      document.getElementById("msg").innerHTML = "Pencereyi kontrol edin";
      window.setTimeout(closeSplash, 1500);
      return;
    }
    window.setTimeout(tick, 1000);
  }

  window.onload = function () {
    window.setTimeout(tick, 1500);
  };
</script>
</head>
<body>
  <div class="wrap">
    <div class="brand">VOTEX</div>
    <div class="sub">TACTICAL GEOPHYSICS</div>
    <div class="msg" id="msg">Y&uuml;kleniyor &mdash; l&uuml;tfen bekleyin</div>
    <div class="bar"><i></i></div>
    <div class="hint">Tekrar t&#305;klamay&#305;n &middot; pencere kendili&#287;inden a&ccedil;&#305;lacak</div>
  </div>
</body>
</html>